<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 shipped a CA store from 2016. Let's Encrypt's own root, ISRG
  Root X1, only entered Android in 7.1.1, and the cross-signed bridge that
  covered older releases (DST Root CA X3) expired on 30 September 2021.

  Chrome hides this because it carries its own root list, but WebView asks the
  operating system — so on a 7.0 handheld (CipherLab R31 and friends) every
  request to the portal fails the TLS handshake while the same URL opens fine
  in the device's browser.

  Shipping the two ISRG roots with the app closes that gap. Scoped to the
  domains the app actually talks to, and "system" stays listed first so this
  only ADDS the roots an old device is missing — it never replaces or weakens
  the platform's own trust decisions, and newer devices behave exactly as before.

  Fingerprints (verified against ISRG's published values):
    ISRG Root X1  SHA-256  96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:
                           CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
    ISRG Root X2  SHA-256  69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:
                           64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70

  X2 is bundled alongside X1 because Let's Encrypt signs ECDSA certificates
  from it; which one the portal is served with can change without notice.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">audix.co.in</domain>
        <domain includeSubdomains="true">up.railway.app</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </domain-config>
</network-security-config>
