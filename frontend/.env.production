# Production Configuration for Audix Online Scanner App
# This URL points to the main website where the audit portal is hosted
# NOTE: the APK workflow (.github/workflows/build-apk.yml) sets
# REACT_APP_BACKEND_URL in its env and is the source of truth; this file only
# keeps local production builds in sync.
REACT_APP_BACKEND_URL=https://data.audix.co.in
GENERATE_SOURCEMAP=false
